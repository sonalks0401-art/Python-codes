


import math

def apply_discount(original_price, coupon_val):
    # using math (optional rounding example)
    final_price = original_price - coupon_val
    return math.floor(final_price)   # rounding down (just to use math)

# Function calls
result1 = apply_discount(50, 10)
result2 = apply_discount(100, 25)

print("Final Price 1:", result1)
print("Final Price 2:", result2)



import math

log_data = ["200", "404", 500, "200", "timeout", "301", 500, "error", "200", 404]

# Extract numeric values
numeric_codes = list(
    map(int, filter(lambda x: str(x).isdigit(), log_data))
)

# Unique values
unique_codes = set(numeric_codes)

# Maximum error
max_error = max(unique_codes)

# Average using math
average = math.fsum(numeric_codes) / len(numeric_codes)

print("Numeric Codes:", numeric_codes)
print("Unique Codes:", unique_codes)
print("Most Severe Error:", max_error)
print("Average:", average)


